# Base URL of the Intrinsic backend API.
#
# Local dev: leave EMPTY. Vite proxies /api -> http://localhost:8000 (see vite.config.ts).
#
# Production (frontend on Vercel, backend hosted elsewhere): set this to the
# backend's origin, with NO trailing /api and no trailing slash, e.g.
#   VITE_API_BASE_URL=https://intrinsic-api.onrender.com
VITE_API_BASE_URL=
