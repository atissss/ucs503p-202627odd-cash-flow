# Intrinsic backend configuration.
# Copy to `.env` and adjust for your machine. `.env` is gitignored — never
# commit real secrets. All variables are prefixed with INTRINSIC_.

# SQLAlchemy database URL. Default is a local SQLite file in backend/.
INTRINSIC_DATABASE_URL=sqlite:///./intrinsic.db

# Comma-separated CORS origins allowed to call the API (the Vite dev server).
INTRINSIC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Secret used to sign auth tokens (Person 2's auth slice). Override with a long
# random value in every real environment.
INTRINSIC_SECRET_KEY=dev-insecure-change-me
