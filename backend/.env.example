# Copy to `.env` and fill in. NEVER commit the real .env.
# All variables are optional in dev (sensible defaults exist); set SECRET_KEY in prod.

INTRINSIC_SECRET_KEY=change-me-to-a-long-random-string
INTRINSIC_DATABASE_URL=sqlite:///./intrinsic.db
INTRINSIC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Financial Modeling Prep key for GET /api/financials/{ticker}. Backend only.
INTRINSIC_FMP_API_KEY=your-fmp-api-key
# Optional cache tuning for ticker lookups (seconds). The free FMP tier allows
# 250 calls/day and each uncached lookup costs 3.
# INTRINSIC_FMP_CACHE_TTL_SECONDS=86400
# INTRINSIC_FMP_NEGATIVE_CACHE_TTL_SECONDS=3600
# INTRINSIC_FMP_STALE_MAX_AGE_SECONDS=604800
# INTRINSIC_FMP_RATE_LIMIT_COOLDOWN_SECONDS=300
